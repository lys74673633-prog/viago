# Supabase (필수)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# legacy anon JWT (eyJ...) 권장 / 또는 sb_publishable_...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# 네이버 소셜 세션 생성·관리용
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# AI (상용 생성 필수)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# OAuth — Google/Kakao/Apple은 Supabase Providers UI에서 설정
# 네이버만 앱 env 필요 (커스텀 라우트)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Toss Payments (실결제)
# https://developers.tosspayments.com/ — 테스트 키로 시작, 사업자 후 live_ck_/live_sk_
# 카카오페이·토스페이는 토스 가맹점 결제수단으로 활성화
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
# 키가 없을 때만 목업 허용. 상용에서는 false 권장
ALLOW_MOCK_PAYMENTS=true

# App
NEXT_PUBLIC_APP_URL=https://viago-two.vercel.app
DAILY_FREE_LIMIT=5

# DEV only — 기본 OFF. true 로 두면 결제 없이 프리미엄 해제(로컬 테스트용)
# NEXT_PUBLIC_DEV_UNLOCK_PREMIUM=true
